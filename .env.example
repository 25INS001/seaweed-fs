# Service names used by the Coolify-managed compose file.
# These are not secrets, but the file is kept out of git so that no .env in
# this repo is ever tracked — see security/check_secrets.sh.
SERVICE_NAME_MASTER=master
SERVICE_NAME_VOLUME=volume
SERVICE_NAME_FILER=filer
SERVICE_NAME_S3=s3
SERVICE_NAME_WEBDAV=webdav

# Rendered into config/s3.json by the deployment. Must match the values the
# application services use.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
